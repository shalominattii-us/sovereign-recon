{
  "dashboard": {
    "uid": "sovereign-stack",
    "title": "Sovereign Stack Overview",
    "tags": ["sovereign", "aegentix", "kernel", "observability"],
    "timezone": "utc",
    "refresh": "30s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Sovereign Kernel Status",
        "type": "stat",
        "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "up{job=\"sovereign-kernel\"}",
            "legendFormat": "AE-Hub v2 Kernel"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "red", "value": null},
                {"color": "green", "value": 1}
              ]
            },
            "mappings": [
              {"type": "value", "options": {"0": "DOWN", "1": "UP"}}
            ]
          }
        }
      },
